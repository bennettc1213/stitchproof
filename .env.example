# Copy to .env.local. Use values from `pnpm exec supabase status` for local services.
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by scoped review/file endpoints, auth limits, workers, and local seeding.
SUPABASE_SERVICE_ROLE_KEY=
# Random server-only HMAC secret, at least 32 characters, for shared authentication attempt limits.
AUTH_RATE_LIMIT_SECRET=
# Development seed requires local Supabase and this explicit guard. Never enable in production.
ALLOW_DEV_SEED=false
DEV_SEED_PASSWORD=
# Email: unconfigured | local (development-only files) | resend.
# Local transport requires localhost Supabase and is rejected in production.
EMAIL_TRANSPORT=unconfigured
RESEND_API_KEY=
# A verified sender address, without a display name.
EMAIL_FROM=
# Random server-only secret of at least 32 characters for email/file maintenance jobs.
OUTBOX_WORKER_SECRET=
# Stripe: use test keys locally. No separate Stripe trial is created.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Fixed $39 USD, licensed, monthly recurring price with no trial.
STRIPE_PRICE_ID=
# Portal: cancellation at period end, plan switching disabled.
STRIPE_PORTAL_CONFIGURATION_ID=
# Live keys are rejected unless NODE_ENV=production, STRIPE_MODE=live, and this explicit guard is true.
STRIPE_ALLOW_LIVE=false
