{
  "name": "threadproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:configure": "node scripts/configure-local.mjs",
    "db:reset": "supabase db reset",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "test:connected": "node --env-file=.env.local scripts/check-connected.mjs",
    "test:workflow": "node --env-file=.env.local scripts/check-ui-workflow.mjs",
    "test:auth": "node --env-file=.env.local scripts/check-auth-workflow.mjs",
    "test:email": "node --env-file=.env.local scripts/check-email-workflow.mjs",
    "test:files": "node --env-file=.env.local scripts/check-file-cleanup.mjs",
    "test:customers": "node --env-file=.env.local scripts/check-customers.mjs",
    "test:controls": "node --env-file=.env.local scripts/check-order-controls.mjs",
    "test:orders": "node --env-file=.env.local scripts/check-order-directory.mjs",
    "test:logo": "node --env-file=.env.local scripts/check-shop-logo.mjs",
    "test:auth-security": "node --env-file=.env.local scripts/check-auth-security.mjs",
    "test:access-security": "node --env-file=.env.local scripts/check-access-security.mjs",
    "test:pdf": "node --env-file=.env.local scripts/check-pdf-content.mjs",
    "test:stripe": "node --env-file=.env.local scripts/check-stripe.mjs",
    "test:forms": "node --env-file=.env.local scripts/check-forms.mjs",
    "test:production": "node --env-file=.env.local scripts/check-production.mjs",
    "email:work": "node --env-file=.env.local scripts/process-outbox.mjs",
    "files:clean": "node --env-file=.env.local scripts/clean-files.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.10.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsqr": "1.4.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
